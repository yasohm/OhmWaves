            </group>
        </vector>
    </aapt:attr>
    <target android:name="body">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:valueType="floatType"
